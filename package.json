{
  "name": "spreadsheet-data-tools",
  "version": "1.0.0",
  "description": "Privacy-focused client-side spreadsheet data processing tools",
  "private": true,
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "test": "elm-test",
    "test:css": "jest tests/css-architecture.test.js",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:all": "npm run test && npm run test:css && npm run build",
    "test:e2e:ci": "start-server-and-test dev http://localhost:8080 test:e2e"
  },
  "dependencies": {
    "cypress": "^15.0.0",
    "file-saver": "2.0.5",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "css-loader": "^6.8.1",
    "elm": "^0.19.1-5",
    "elm-format": "^0.8.8",
    "elm-hot-webpack-loader": "^1.1.8",
    "elm-test": "^0.19.1-revision12",
    "elm-webpack-loader": "^7.0.1",
    "glob": "^8.1.0",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.7.0",
    "mini-css-extract-plugin": "^2.7.6",
    "start-server-and-test": "^2.0.3",
    "style-loader": "^3.3.3",
    "webpack": "^5.74.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ]
}
